namespace Vaani.API.Models.DTOs;

/// <summary>
/// Request model for updating an existing meeting
/// </summary>
public class UpdateMeetingRequest
{
    public string? MeetingName { get; set; }
    public string? AzureSubscriptionKey { get; set; }
    public string? AzureRegion { get; set; }
    public string? VendorLanguageCode { get; set; }
    public string? VendorVoice { get; set; }
    public string? OrganizerLanguageCode { get; set; }
    public string? OrganizerVoice { get; set; }
    public DateTime? ValidFrom { get; set; }
    public DateTime? ValidUntil { get; set; }
    public bool? AllowReconnect { get; set; }
    public int? HeartbeatIntervalSeconds { get; set; }
    public bool? EnableLocalCache { get; set; }
    public bool? IsActive { get; set; }
}
