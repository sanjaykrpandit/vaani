namespace Vaani.API.Interfaces;

/// <summary>
/// Interface for JWT token operations
/// </summary>
public interface IJwtTokenService
{
    /// <summary>
    /// Generate a JWT token for a session
    /// </summary>
    string GenerateToken(string meetingId, string deviceId, DateTime expiresAt);
    
    /// <summary>
    /// Generate a JWT token for admin user
    /// </summary>
    string GenerateAdminToken(string userId, string fullName, DateTime expiresAt);
    
    /// <summary>
    /// Validate a JWT token and extract claims
    /// </summary>
    (bool isValid, string? meetingId, string? deviceId) ValidateToken(string token);
    
    /// <summary>
    /// Validate an admin JWT token and extract claims
    /// </summary>
    (bool isValid, string? userId, string? fullName) ValidateAdminToken(string token);
    
    /// <summary>
    /// Get expiration time from token
    /// </summary>
    DateTime? GetTokenExpiration(string token);
}
