{
  "ConnectionStrings": {
    "PostgreSQL": "Host=your-rds-endpoint.amazonaws.com;Port=5432;Database=vaani_db;Username=admin;Password=your_production_password;SSL Mode=Require"
  },
  "Jwt": {
    "Secret": "ProductionSecretKeyFromAWSSecretsManager",
    "Issuer": "VaaniAPI",
    "Audience": "VaaniDesktopApp",
    "ExpirationHours": 4
  },
  "Encryption": {
    "AesKey": "ProductionAES256KeyFromSecretsManager"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
