{
  "Authentication": {
    "ApiBaseUrl": "https://localhost:7020/api",
    "ApiTimeout": 30
  },
  "AudioCapture": {
    "EnableSilenceFiltering": false,
    "SilenceThresholdLevel": 500,
    "PreRollChunks": 2,
    "TrailingSilenceChunks": 4,
    "SendQueueCapacity": 16,
    "DropAudioWhileDisconnected": true,
    "EnableDiagnostics": false
  },
  "Realtime": {
    "DefaultConnectionMode": "DirectAzure",
    "DirectTokenRefreshLeadSeconds": 90,
    "DirectProfanityOption": "Removed",
    "DirectSegmentationSilenceTimeoutMs": 500,
    "DirectAudioBufferMilliseconds": 50,
    "DirectDisableClientSilenceFilter": true
  }
}