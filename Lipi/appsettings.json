{
  "Authentication": {
    "ApiBaseUrl": "https://localhost:7020",
    "ApiTimeout": 30
  },
  "AudioCapture": {
    "EnableSilenceFiltering": false,
    "SilenceThresholdLevel": 500,
    "PreRollChunks": 2,
    "TrailingSilenceChunks": 4,
    "SendQueueCapacity": 16,
    "DropAudioWhileDisconnected": true,
    "EnableDiagnostics": false
  },
  "Realtime": {
    "DefaultConnectionMode": "DirectAzure",
    "DirectTokenRefreshLeadSeconds": 90,
    "DirectProfanityOption": "Removed",
    "DirectSegmentationSilenceTimeoutMs": 500,
    "DirectAudioBufferMilliseconds": 50,
    "DirectDisableClientSilenceFilter": true,
    "DirectEnableConversationalRewrite": true,
    "DirectConversationalRewriteDomain": "general",
    "DirectGenericCleanupEnabled": true,
    "DirectAiFallbackEnabled": true,
    "DirectRecognizingRewriteEnabled": true,
    "DirectRecognizingRewriteMinIntervalMs": 300,
    "DirectRecognizingRewriteMinTextLength": 10,
    "DirectPullQueueCapacitySeconds": 6,
    "DirectMaxRecognizerRestarts": 5,
    "DirectRecognizerRestartDelayMs": 500,
    "DirectMaxQuotaRestarts": 3,
    "DirectQuotaRetryBaseDelayMs": 3000
  }
}