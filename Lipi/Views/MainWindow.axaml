<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:media="clr-namespace:Avalonia.Media;assembly=Avalonia.Base"
        xmlns:models="using:Lipi.Models"
        xmlns:vm="using:Lipi.ViewModels"
        x:Class="Lipi.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="350" Height="600"
        MinWidth="250" MinHeight="600"
        TransparencyLevelHint="Transparent"
        Background="#AA000000"
        SystemDecorations="BorderOnly"
        CanResize="True"
        Topmost="True"
        Icon="/Assets/icon.ico"
        Title="Vaani Translator">

  <Window.Styles>

    <Style Selector="Border.settings-shell">
      <Setter Property="Background" Value="#990A0A0A"/>
      <Setter Property="BorderBrush" Value="#556B6B6B"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.settings-section">
      <Setter Property="Background" Value="#B31A1A1A"/>
      <Setter Property="BorderBrush" Value="#2AFFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="TextBlock.settings-label">
      <Setter Property="Foreground" Value="#DCEBFF"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="CheckBox.settings-check">
      <Setter Property="Foreground" Value="#F2F7FF"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="TextBlock.recognizing-dot">
      <Setter Property="Foreground" Value="#9CCC65"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Opacity" Value="0.25"/>
      <Setter Property="Margin" Value="0,-4,0,0"/>
    </Style>

    <Style Selector="TextBlock.dot-1">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
          <KeyFrame Cue="35%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.dot-2">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" Delay="0:0:0.15">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
          <KeyFrame Cue="35%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="TextBlock.dot-3">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" Delay="0:0:0.3">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
          <KeyFrame Cue="35%">
            <Setter Property="Opacity" Value="1"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.25"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

  </Window.Styles>

  <!-- Window root: fully transparent, no border -->
  <Border CornerRadius="10" BorderThickness="1" Padding="10,1,10,10">
    <Grid RowDefinitions="Auto,*">

      <Border x:Name="HeaderPanel" Grid.Row="0"
              Margin="0,0,0,6"            
			  Padding="6"
              CornerRadius="6"
              Background="{Binding HeaderPanelBackground}"
              Opacity="{Binding HeaderChromeOpacity}"
              IsHitTestVisible="{Binding IsHeaderVisible}">
        <Border.Transitions>
          <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
          </Transitions>
        </Border.Transitions>
        <Grid RowDefinitions="Auto,Auto"  PointerPressed="DragArea_OnPointerPressed">

      <!-- ── Header drag area ── -->
      <Grid x:Name="HeaderDragArea" Grid.Row="0"
            ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
            MinHeight="28"
            Background="Transparent"
            PointerPressed="DragArea_OnPointerPressed">

        <!--<StackPanel Orientation="Horizontal" Spacing="4" Margin="2,0" VerticalAlignment="Center">
          <Image Source="/Assets/icon.ico" Width="18" Height="18" Opacity="0.7"/>
        </StackPanel>-->

        <Border Grid.Column="0"
                IsVisible="{Binding IsSubtitleMode}"
                Margin="0,0,4,0"
                Height="22"				
                Padding="1,0"
                CornerRadius="4"
                BorderBrush="#44FFFFFF"
                BorderThickness="1"
				MinWidth="32"
                Background="#22FFFFFF">
          <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
            <Button Content="◀"
                    Click="SubtitleNarrowButton_OnClick"
                    Width="18" Height="18" Padding="0"
                    FontSize="7"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Narrow subtitle window (−5%)"
                    Foreground="White"
                    BorderThickness="0" CornerRadius="3"/>
            <Button Content="▶"
                    Click="SubtitleWideButton_OnClick"
                    Width="18" Height="18" Padding="0"
                    FontSize="7"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Widen subtitle window (+5%)"
                    Foreground="White"
                    BorderThickness="0" CornerRadius="3"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1"
                IsVisible="{Binding IsSubtitleMode}"
                Margin="2,0"
                Height="22"
                Padding="2,0"
                CornerRadius="4"
                BorderBrush="#44BFD7FF"
                BorderThickness="1"
                Background="#143A5A88">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Content="A"
                    Command="{Binding DecreaseSubtitleFontCommand}"
                    Width="20" Height="20" Padding="0"
                    FontSize="9"
                    FontWeight="SemiBold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Decrease font"
                    Foreground="White"
                    BorderBrush="#66BFD7FF"
                    BorderThickness="1" CornerRadius="3"/>
            <Button Content="A"
                    Command="{Binding IncreaseSubtitleFontCommand}"
                    Width="20" Height="20" Padding="0"
                    FontSize="12"
                    FontWeight="Bold"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Increase font"
                    Foreground="White"
                    BorderBrush="#66BFD7FF"
                    BorderThickness="1" CornerRadius="3"/>
          </StackPanel>
        </Border>
        <Button Grid.Column="2" Content="A"
                Command="{Binding ToggleSubtitleTextColorCommand}"
                IsVisible="{Binding IsSubtitleMode}"
                Margin="2,0" Height="22" Width="20" Padding="0"
                FontSize="10"
                FontWeight="Bold"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Toggle subtitle text color"
                Foreground="{Binding SubtitleColorButtonForeground}"
                Background="{Binding SubtitleColorButtonBackground}"
                BorderBrush="{Binding SubtitleColorButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"/>
        <Border Grid.Column="3"
                IsVisible="{Binding IsSubtitleMode}"
                Margin="2,0"
                Height="22"
                Padding="2,0"
                CornerRadius="4"
                BorderBrush="#44C8E6C9"
                BorderThickness="1"
                Background="#143A6A3F">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
            <Button Content="−"
                    Command="{Binding DecreaseSubtitleBackgroundOpacityCommand}"
                    Width="20" Height="20" Padding="0"
                    FontSize="10"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Decrease subtitle background opacity"
                    Foreground="White"
                    BorderBrush="#66C8E6C9"
                    BorderThickness="1" CornerRadius="3"/>
            <Button Content="+"
                    Command="{Binding IncreaseSubtitleBackgroundOpacityCommand}"
                    Width="20" Height="20" Padding="0"
                    FontSize="10"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="Increase subtitle background opacity"
                    Foreground="White"
                    BorderBrush="#66C8E6C9"
                    BorderThickness="1" CornerRadius="3"/>
          </StackPanel>
        </Border>
        <Button Grid.Column="4" Content="{Binding TranscriptToggleText}"
                Command="{Binding ToggleTranscriptVisibilityCommand}"
                IsVisible="{Binding IsSubtitleMode}"
                Margin="2,0" Height="22" MinWidth="50" Padding="2,0"
                FontSize="11"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Show or hide transcript"
                Foreground="White"
                BorderThickness="0" CornerRadius="4"/>
        <Button Grid.Column="5" Content="⚙"
                Command="{Binding ShowSettingsCommand}"
                IsVisible="{Binding !IsSubtitleMode}"
                Margin="2,0" Height="22" Width="20" Padding="0"
                FontSize="11"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Settings"
                Foreground="White"
                BorderThickness="0" CornerRadius="4"/>
        <Button Grid.Column="6" Content="{Binding SubtitleModeButtonText}"
                Command="{Binding ToggleSubtitleModeCommand}"
                IsVisible="{Binding IsRunning}"
                Margin="2,0" Height="22" MinWidth="40" Padding="2,0"
                FontSize="10"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                ToolTip.Tip="Subtitle mode"
                Foreground="White"
                BorderThickness="0" CornerRadius="4"/>
        <Button Grid.Column="7"
                Content="{Binding StartStopText}"
                Command="{Binding StartStopCommand}"
                Margin="2,0,4,0" Height="22" MinWidth="40" Padding="2,0"
                FontSize="10"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Foreground="White"
                Background="{Binding StartStopBackground}"
                BorderBrush="#66FFFFFF"
                BorderThickness="1"
                CornerRadius="4"/>
        <Button Grid.Column="8" Content="—"
                Click="MinimizeButton_OnClick"
                Margin="2,0" Height="22" Width="22" Padding="0"
                FontSize="10"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Minimize"
                Foreground="White"
                BorderThickness="0" CornerRadius="4"/>
        <Button Grid.Column="9" Content="✕"
                Click="CloseButton_OnClick"
                Margin="2,0" Height="22" Width="22" Padding="0"
                FontSize="10"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Close"
                 Foreground="White"
                BorderThickness="0" CornerRadius="4"/>
      </Grid>

      <Border x:Name="StatusRow" Grid.Row="1"
              CornerRadius="6"
              Padding="4,4"
              Background="Transparent"
              BorderBrush="#22FFFFFF"
              BorderThickness="0,1,0,0"
		      PointerPressed="DragArea_OnPointerPressed">
        <TextBlock Text="{Binding Status}"
                   FontSize="12"
                   Foreground="#F2FFFFFF"/>
      </Border>
        </Grid>
      </Border>

      <!-- ── Transcript bubbles ── -->
      <Grid Grid.Row="1" Margin="0,6,0,0" IsVisible="{Binding IsBubbleListVisible}">
        <ScrollViewer x:Name="BubbleScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Bubbles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:TranscriptBubble">
                <Border HorizontalAlignment="Stretch"                      
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Margin="0,0,0,8"
                        Padding="10">
                  <StackPanel Spacing="5">

                    <!-- Transcript line -->
                    <Grid ColumnDefinitions="Auto,*">
                      <StackPanel Grid.Column="0"
                                  Orientation="Horizontal"
                                  IsVisible="{Binding IsRecognizing}"
                                  VerticalAlignment="Center">
                        <TextBlock Classes="recognizing-dot dot-1" Text="."/>
                        <TextBlock Classes="recognizing-dot dot-2" Text="."/>
                        <TextBlock Classes="recognizing-dot dot-3" Text="."/>
                      </StackPanel>
                      <TextBlock Grid.Column="1"
                                 Margin="4,0,0,0"
                                 Text="{Binding Transcript}"
                                 TextWrapping="Wrap"
                                 FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                 FontSize="12"
                                 FontStyle="Italic"
                                 LineHeight="22"
                                 FontWeight="Bold"
                                 Foreground="White"/>
                    </Grid>

                    <!-- Translation rows -->
                    <ItemsControl ItemsSource="{Binding Translations}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Margin="0,3,0,0"
                                  Padding="6"
                                  CornerRadius="4"                               
                                  BorderBrush="#44FFFFFF"
                                  BorderThickness="1">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding ShortLanguageCode}"
                                         FontSize="10"
                                         FontWeight="Bold"
                                         Foreground="#CCFFFFFF"
                                         VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1"
                                         Margin="6,0,0,0"
                                         Text="{Binding Text}"
                                         TextWrapping="Wrap"
                                         FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                         FontSize="14"
                                         FontWeight="Bold"
                                         Foreground="White"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- ── Settings panel ── -->
      <ExperimentalAcrylicBorder x:Name="SettingPanel"
                             Grid.Row="1"
                                 Classes="settings-shell"
                                 CornerRadius="8"
                                 Padding="6"
                                 IsVisible="{Binding IsSettingsPanelVisible}"
                                 VerticalAlignment="Stretch"
                                 ClipToBounds="True">
        <ExperimentalAcrylicBorder.Material>
          <ExperimentalAcrylicMaterial BackgroundSource="{x:Static media:AcrylicBackgroundSource.Digger}"
                                       TintColor="#111111"
                                       TintOpacity="0.62"
                                       MaterialOpacity="0.78"
                                       PlatformTransparencyCompensationLevel="0"/>
        </ExperimentalAcrylicBorder.Material>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto">

            <Border Grid.Row="0" Classes="settings-section" CornerRadius="6" Padding="8">
              <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <TextBlock Classes="settings-label" Text="Speaking language"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding SourceLanguages}"
                          SelectedItem="{Binding SelectedSourceLanguage}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="settings-section" CornerRadius="6" Padding="8" Margin="0,6,0,0">
              <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <TextBlock Classes="settings-label" Text="Microphone"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding InputDevices}"
                          SelectedItem="{Binding SelectedInputDevice}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="settings-section" CornerRadius="6" Padding="6"
                    Margin="0,6,0,0">
              <StackPanel Spacing="6" HorizontalAlignment="Stretch">
                <TextBlock Classes="settings-label" Text="Connection mode"/>
                <ComboBox HorizontalAlignment="Stretch"
                          ItemsSource="{Binding ConnectionModes}"
                          SelectedItem="{Binding SelectedConnectionMode}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding DisplayName}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="settings-section" CornerRadius="6" Padding="6"
                    Margin="0,6,0,0" VerticalAlignment="Stretch">
              <Grid RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Classes="settings-label" Text="Output languages"/>
                <ItemsControl Grid.Row="1" Margin="0,4,0,0" ItemsSource="{Binding TargetLanguages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="4" Padding="6" Margin="0,0,0,4" >
                        <CheckBox Classes="settings-check" Content="{Binding DisplayName}" IsChecked="{Binding IsSelected}"/>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </Border>

          </Grid>
        </ScrollViewer>
      </ExperimentalAcrylicBorder>

		
	  <Grid x:Name="SubtitleGridPanel" Grid.Row="1"
				  IsVisible="{Binding IsSubtitleMode}"
				  Margin="0,0,0,0"
				  VerticalAlignment="Bottom"
				  HorizontalAlignment="Stretch">
				<StackPanel HorizontalAlignment="Center"
							MaxWidth="1100"
							Spacing="4">
					<Border IsVisible="{Binding SubtitleTranscriptVisible}"
                          Background="{Binding SubtitleBackgroundBrush}"
							CornerRadius="6"
                            Padding="6,1,6,1"
							HorizontalAlignment="Stretch"
							Margin="0,0,0,2">
						<TextBlock Text="{Binding SubtitleTranscriptText}"
								   FontSize="{Binding SubtitleTranscriptFontSize}"
                                   FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                   Foreground="{Binding SubtitleTranscriptForeground}"
								   TextWrapping="Wrap"
                                   LineHeight="24"
								   TextAlignment="Left"
								   HorizontalAlignment="Stretch"
								   FlowDirection="LeftToRight"
                                   Margin="0,4,0,2"/>
					</Border>

					<ItemsControl ItemsSource="{Binding SubtitleLanguageLines}"
                                  IsVisible="{Binding HasSubtitleLanguageLines}"
                                  HorizontalAlignment="Stretch">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Vertical" Spacing="6"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
                     <DataTemplate x:DataType="models:SubtitleLanguageLine">
                              <Border Background="{Binding SubtitleBackgroundBrush}"
                                        BorderBrush="#556B6B6B"
                                        BorderThickness="0"
										CornerRadius="6"
										Padding="8,8,8,8"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding OlderRecognizedText}"
                                                   IsVisible="{Binding HasOlderRecognizedText}"
                                                   FontSize="{Binding DisplayFontSize}"
                                                   FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SecondaryForeground}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="{Binding DisplayLineHeight}"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding LatestText}"
                                                   IsVisible="{Binding IsLatestRecognized}"
                                                   FontSize="{Binding DisplayFontSize}"
                                                   FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding PrimaryForeground}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="{Binding DisplayLineHeight}"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding LatestText}"
                                                   IsVisible="{Binding IsLatestRecognizing}"
                                                   FontSize="{Binding DisplayFontSize}"
                                                   FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                                   FontStyle="Italic"
                                                   Foreground="{Binding RecognizingForeground}"
                                                   TextWrapping="Wrap"
                                                   LineHeight="{Binding DisplayLineHeight}"
                                                   TextAlignment="Left"
                                                   HorizontalAlignment="Stretch"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

                    <Border IsVisible="{Binding ShowSubtitleTranslatedPlaceholder}"
                          Background="{Binding SubtitleBackgroundBrush}"
                          BorderBrush="#556B6B6B"
                          BorderThickness="0"
                            CornerRadius="6"
                            Padding="16,10,16,12"
                          HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding SubtitleTranslatedText}"
                                   FontSize="{Binding SubtitleFontSize}"
                                   FontFamily="Segoe UI, Yu Gothic UI, Meiryo, Nirmala UI, Mangal"
                                   FontWeight="Bold"
                                   Foreground="{Binding SubtitlePrimaryForeground}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   HorizontalAlignment="Stretch"
                                   FlowDirection="LeftToRight"
                                   Margin="0,2,0,0"/>
                    </Border>
					
				</StackPanel>
			</Grid>
	
    </Grid>
  </Border>
</Window>
