<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lipi.ViewModels"
        x:Class="Lipi.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="360" Height="660"
        MinWidth="360" MinHeight="500"
        TransparencyLevelHint="Blur"
        Background="#00000000"
        SystemDecorations="None"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico"
        Title="">
  <Border Background="#EF000000" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="12" ClipToBounds="True" Padding="10,0,10,10">
    <Grid RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent" PointerPressed="Header_OnPointerPressed" Margin="0,0,0,8">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="/Assets/icon.ico" Width="18" Height="18"/>        
        </StackPanel>
        <Button Grid.Column="1"
                Content="✕"
                Click="CloseButton_OnClick"
                ToolTip.Tip="Close"
                Background="#EF000000"
                Foreground="White"
                BorderBrush="#66FFFFFF"
                BorderThickness="0"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="18" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding !IsAutoLoginProcessing}">       
        <TextBlock Text="Meeting ID" Foreground="Gray"/>
        <TextBox Text="{Binding MeetingId}" Watermark="VAANI-..."/>
        <TextBlock Text="Your Name" Foreground="Gray"/>
        <TextBox Text="{Binding UserName}" />
        <TextBlock Text="Password (if required)" Foreground="Gray"/>
        <TextBox Text="{Binding Password}" PasswordChar="*"/>
        <Button Content="Login"
                Command="{Binding LoginCommand}"
                IsEnabled="{Binding !IsBusy}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Height="36"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#FFCC80"/>
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="18" Spacing="12" VerticalAlignment="Center" IsVisible="{Binding IsAutoLoginProcessing}">
        <ProgressBar IsIndeterminate="True" Height="6"/>
        <TextBlock Text="Signing in..." HorizontalAlignment="Center" Foreground="Gray"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>