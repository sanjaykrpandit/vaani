<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- CLICKONCE: THE "RUN" BUTTON CONFIGURATION -->
    <!-- Setting Install to false changes the prompt from 'Install' to 'Run' -->
    <Install>false</Install>
    <InstallFrom>Web</InstallFrom>
    <IsWebBootstrapper>true</IsWebBootstrapper>
    <InstallUrl>http://localhost/vconsole/</InstallUrl>
    <UpdateEnabled>false</UpdateEnabled>
    <CreateDesktopShortcut>false</CreateDesktopShortcut>
    
    
    <ProductName>vconsole</ProductName>
    <PublisherName>Your Company</PublisherName>
    <SuiteName>vconsole Suite</SuiteName>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>1.0.0.1</ApplicationVersion>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>
    
    <!-- Build & Runtime Settings -->
    <!-- Note: ClickOnce 'Run' mode works best with PublishSingleFile=false, 
         but if you need it, ensure it doesn't conflict with manifest generation -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.0.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.0.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.0.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.0.10" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.0.10" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.47.0" />
    <PackageReference Include="Microsoft.CognitiveServices.Speech.Extension.MAS" Version="1.47.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="installer\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\Desktop\Desktop\New folder\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
