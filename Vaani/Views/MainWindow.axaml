<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vaani.ViewModels"
        xmlns:conv="using:Vaani.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="Vaani.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
		Icon="/Assets/icon.ico"
        Title="Vaani"
        Width="400" Height="650"
        MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<conv:DeviceEqualityConverter x:Key="DeviceEqualityConverter" />
		<conv:BoolToBrushConverter x:Key="BoolToBrushConverter" />
		<conv:BoolToBrushBtnConverter x:Key="BoolToBrushBtnConverter" />
		<conv:MessageBubbleColorConverter x:Key="MessageBubbleColorConverter" />
		<conv:BoolToIconConverter x:Key="BoolToIconConverter" />
		<conv:BoolToImageConverter x:Key="BoolToImageConverter" />
		<conv:MessageSourceConverter x:Key="MessageSourceConverter" />
	</Window.Resources>

	<Window.Styles>
		<!-- Custom ToggleButton style to ensure background binding works -->
		<Style Selector="ToggleButton.mute-button">
			<Setter Property="Background" Value="#000000"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.2" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="ToggleButton.mute-button:pointerover">
			<Setter Property="Background" Value="#1a1a1a"/>
		</Style>
		<Style Selector="ToggleButton.mute-button:pressed">
			<Setter Property="Background" Value="#0d0d0d"/>
		</Style>

		<!-- Override ContentPresenter background in template to prevent default theme colors -->
		<Style Selector="ToggleButton.mute-button /template/ ContentPresenter">
			<Setter Property="Background" Value="{TemplateBinding Background}"/>
		</Style>

		<!-- RadioButton checked state - customize the accent color -->
		<Style Selector="RadioButton:checked /template/ Ellipse#OuterEllipse">
			<Setter Property="Stroke" Value="#4CAF50"/>
			<Setter Property="StrokeThickness" Value="2"/>
		</Style>
		<Style Selector="RadioButton:checked /template/ Ellipse#CheckGlyph">
			<Setter Property="Fill" Value="#4CAF50"/>
		</Style>

		<!-- RadioButton hover state -->
		<Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse">
			<Setter Property="Stroke" Value="#888888"/>
		</Style>

		<!-- RadioButton checked + hover state -->
		<Style Selector="RadioButton:checked:pointerover /template/ Ellipse#OuterEllipse">
			<Setter Property="Stroke" Value="#66BB6A"/>
		</Style>
		<Style Selector="RadioButton:checked:pointerover /template/ Ellipse#CheckGlyph">
			<Setter Property="Fill" Value="#66BB6A"/>
		</Style>

		<!-- Message Bubble Animation Style with better approach -->
		<Style Selector="ListBoxItem">
			<Setter Property="RenderTransform" Value="translateY(0)"/>
			<Setter Property="Opacity" Value="1"/>
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="CubicEaseOut"/>
					<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.8" Easing="CubicEaseOut"/>
				</Transitions>
			</Setter>
		</Style>
	</Window.Styles>

	<Design.DataContext>
		<vm:MainViewModel/>
	</Design.DataContext>

	<Grid>

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto">
		<!-- Header -->
		<Border Grid.Row="0" Grid.ColumnSpan="2" Background="#252526" Padding="5">
			<Grid ColumnDefinitions="Auto,*,Auto">
				<!-- View Toggle Buttons -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
					<Button Command="{Binding ShowConsoleViewCommand}"
                            Width="24" Height="24"
                            Background="#1F1F1F"
							Padding="4"
							ToolTip.Tip="Console View"
                            CornerRadius="4">
						<Image Source="/Assets/console.png"
							   Width="18" Height="18"
							   Stretch="Uniform"/>
					</Button>
					<Button Command="{Binding ShowMessageViewCommand}"
                            Width="24" Height="24"
							Padding="4"
                            Background="#1F1F1F"
                            CornerRadius="4"
							ToolTip.Tip="Message View">
						<Image Source="/Assets/chat.png"
							   Width="18" Height="18"
							   Stretch="Uniform"/>
					</Button>
					<Button Command="{Binding ClearMessage}"
                            Width="24" Height="24"
							Padding="4"
                            Background="#1F1F1F"
                            CornerRadius="4"
							ToolTip.Tip="Clear Logs and Messages">
						<Image Source="/Assets/clear.png"
							   Width="18" Height="18"
							   Stretch="Uniform"/>
					</Button>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
					<Button Content="⚙"
							Width="28" Height="28"
							FontSize="18"
							Padding="2"
							Background="#252526"
							Foreground="White"
							Command="{Binding ToggleSettingsPanelCommand}"/>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Main Content -->
		<Grid Grid.Row="1" Grid.Column="0" Margin="0">
			<Grid RowDefinitions="*,Auto">
				<!-- Console Log View -->
				<Border Grid.Row="0"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="0,1,0,0"
                        Padding="0"
                        IsVisible="{Binding !IsMessageViewActive}">
					<Grid RowDefinitions="Auto,*">
						<Border Grid.Row="0" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
							<TextBlock Text="📋 Translation Log"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#CCCCCC" />
						</Border>
						<ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
							<TextBox Text="{Binding LogText}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     Foreground="#D4D4D4"
                                     FontFamily="Cascadia Code,Consolas,monospace"
                                     FontSize="14"
                                     Padding="15"
                                     BorderThickness="0"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"/>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Message Bubbles View -->
				<Border Grid.Row="0"
                        Background="#1E1E1E"
                        BorderBrush="#3E3E42"
                        BorderThickness="0,1,0,0"
                        Padding="0"
                        IsVisible="{Binding IsMessageViewActive}">
					<Grid RowDefinitions="Auto,*">
						<ScrollViewer Grid.Row="1"
                                      x:Name="MessageScroller"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="15,15,10,15">
							<!-- Narrow scrollbar styling scoped to this ScrollViewer -->
							<ScrollViewer.Styles>
								<Style Selector="ScrollViewer ScrollBar#PART_VerticalScrollBar">
									<Setter Property="Width" Value="4"/>
									<Setter Property="Background" Value="#222"/>
								</Style>
								<Style Selector="ScrollViewer ScrollBar#PART_VerticalScrollBar /template/ Thumb">
									<Setter Property="Background" Value="#666"/>
									<Setter Property="CornerRadius" Value="3"/>
								</Style>
								<Style Selector="ScrollViewer ScrollBar#PART_HorizontalScrollBar">
									<Setter Property="Height" Value="4"/>
									<Setter Property="Background" Value="#222"/>
								</Style>
								<Style Selector="ScrollViewer ScrollBar#PART_HorizontalScrollBar /template/ Thumb">
									<Setter Property="Background" Value="#666"/>
									<Setter Property="CornerRadius" Value="3"/>
								</Style>
							</ScrollViewer.Styles>

							<!-- Wrap list and spacer to add bottom padding -->
							<StackPanel>
								<!-- Virtualized list for smoother scrolling -->
								<ListBox ItemsSource="{Binding Messages}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         HorizontalAlignment="Stretch">
									<ListBox.ItemsPanel>
										<ItemsPanelTemplate>
											<VirtualizingStackPanel/>
										</ItemsPanelTemplate>
									</ListBox.ItemsPanel>

									<!-- Remove selection visuals -->
									<ListBox.Styles>
										<Style Selector="ListBoxItem">
											<Setter Property="IsHitTestVisible" Value="False"/>
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Margin" Value="0,0,0,12"/>
											<Setter Property="Background" Value="Transparent"/>
										</Style>
										<Style Selector="ListBoxItem:selected">
											<Setter Property="Background" Value="Transparent"/>
										</Style>
									</ListBox.Styles>

									<ListBox.ItemTemplate>
										<DataTemplate>
											<!-- Use Grid to create 80% width constraint -->
											<Grid ColumnDefinitions="4*,*">
												<Border Grid.Column="0" 
												        HorizontalAlignment="Stretch">
													<Border Background="{Binding IsFromMeeting, Converter={StaticResource MessageBubbleColorConverter}}"
                                                            CornerRadius="7"
                                                            Padding="10,6"
                                                            UseLayoutRounding="True"
                                                            BoxShadow="0 1 3 0 #22000000">
														<!-- Grid to position synthesizing indicator in top-right -->
														<Grid>
															<StackPanel Spacing="6">
															<!-- Message Source Label -->
															<TextBlock Foreground="#B0B0B0" FontSize="8" FontWeight="SemiBold">
																<TextBlock.Text>
																	<MultiBinding>
																		<MultiBinding.Converter>
																			<conv:MessageSourceConverter/>
																		</MultiBinding.Converter>
																		<Binding Path="IsSystemMessage"/>
																		<Binding Path="IsFromMeeting"/>
																	</MultiBinding>
																</TextBlock.Text>
															</TextBlock>

															<!-- Original Text -->
															<TextBlock Text="{Binding OriginalText}"
                                                                       Foreground="White"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="18"
                                                                       Padding="0,2,0,0"
                                                                       UseLayoutRounding="True"
                                                                       TextTrimming="None">
												<!-- ✅ Smooth opacity transition for animated text -->
												<TextBlock.Transitions>
													<Transitions>
														<DoubleTransition Property="Opacity" Duration="0:0:0.2" />
													</Transitions>
												</TextBlock.Transitions>
											</TextBlock>

															<!-- Recognizing indicator -->
															<StackPanel Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        IsVisible="{Binding IsRecognizing}">
																<TextBlock Text="●"
                                                                           Foreground="#4CAF50"
                                                                           FontSize="10"
                                                                           Padding="0,3,0,0"
                                                                           VerticalAlignment="Center">
																	<TextBlock.Styles>
																		<Style Selector="TextBlock">
																			<Style.Animations>
																				<Animation Duration="0:0:1.5" IterationCount="Infinite">
																					<KeyFrame Cue="0%">
																						<Setter Property="Opacity" Value="1.0"/>
																					</KeyFrame>
																					<KeyFrame Cue="50%">
																						<Setter Property="Opacity" Value="0.3"/>
																					</KeyFrame>
																					<KeyFrame Cue="100%">
																						<Setter Property="Opacity" Value="1.0"/>
																					</KeyFrame>
																				</Animation>
																			</Style.Animations>
																		</Style>
																	</TextBlock.Styles>
																</TextBlock>
																<TextBlock Text="Listening..."
                                                                           Foreground="#90CAF9"
                                                                           FontSize="12"
                                                                           FontStyle="Italic"
                                                                           VerticalAlignment="Center"/>
															</StackPanel>

															<!-- Translated Text -->
															<TextBlock Text="{Binding TranslatedText}"
                                                                       Foreground="#E0E0E0"
                                                                       FontSize="14"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="18"
                                                                       Padding="0,2,0,0"
                                                                       Margin="0,0,0,0"
                                                                       UseLayoutRounding="True"
                                                                       TextTrimming="None"
                                                                       IsVisible="{Binding TranslatedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
												<!-- ✅ Smooth opacity transition for animated translated text -->
												<TextBlock.Transitions>
													<Transitions>
														<DoubleTransition Property="Opacity" Duration="0:0:0.3" />
													</Transitions>
												</TextBlock.Transitions>
											</TextBlock>
														</StackPanel>

														<!-- Synthesizing indicator - positioned in top-right corner -->
														<StackPanel Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    IsVisible="{Binding IsSynthesizing}"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,0,0,0">
															<TextBlock Text="🔊"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center">
																<TextBlock.Styles>
																	<Style Selector="TextBlock">
																		<Style.Animations>
																			<Animation Duration="0:0:0.8" IterationCount="Infinite">
																				<KeyFrame Cue="0%">
																					<Setter Property="Opacity" Value="1.0"/>
																				</KeyFrame>
																				<KeyFrame Cue="50%">
																					<Setter Property="Opacity" Value="0.4"/>
																				</KeyFrame>
																				<KeyFrame Cue="100%">
																					<Setter Property="Opacity" Value="1.0"/>
																				</KeyFrame>
																			</Animation>
																		</Style.Animations>
																	</Style>
																</TextBlock.Styles>
															</TextBlock>
														</StackPanel>
													</Grid>
												</Border>
											</Border>
										</Grid>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>

								<!-- Bottom spacer to ensure last message is always visible -->
								<Panel Height="80"/>
							</StackPanel>
						</ScrollViewer>
					</Grid>
				</Border>

				<!-- Status Bar removed from here and moved to root level so it remains visible when settings overlay appears -->
			</Grid>
		</Grid>

		<!-- Settings/Control Panel (overlay) -->
		<Border Grid.Row="1"
                Grid.ColumnSpan="2"
                Background="#252526"
                Width="400"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Margin="0,0,0,0"
                Padding="0"
                IsVisible="{Binding IsSettingsPanelVisible}"
                BorderBrush="#3E3E42"
                BorderThickness="1,1,1,1"
                ZIndex="100">
			<Grid RowDefinitions="Auto,*">
				<!-- Settings Header -->
				<Border Grid.Row="0" Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Grid.Column="0"
								   Text="Settings"
								   FontSize="14"
								   FontWeight="SemiBold"
								   Foreground="#CCCCCC"
								   VerticalAlignment="Center"/>

						<Button Grid.Column="1"
								Command="{Binding LogoutCommand}"
								Width="53" Height="22"
								FontSize="11"
								Padding="2"
								Background="#000000"
								Foreground="White"
								   HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
							<TextBlock Text="Logout" FontWeight="SemiBold"/>
						</Button>
					</Grid>
				</Border>

				<!-- Settings Content -->
				<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15,15,5,15">
					<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

						<!-- Language Settings -->
						<Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,*" Margin="0,0,15,0">
							<StackPanel Grid.Column="0" VerticalAlignment="Top">
								<TextBlock Text="Your Language" Foreground="White"  FontSize="13" Margin="0,0,0,7"/>
								<ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding SelectedSourceLanguage, Mode=TwoWay}"
                                          IsEnabled="{Binding !IsRunning}"
                                          HorizontalAlignment="Stretch"  FontSize="13">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding DisplayName}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

							<StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Top">
								<TextBlock Text="Gender" Foreground="White"  FontSize="13" Margin="0,0,0,7"/>
								<ComboBox ItemsSource="{Binding Genders}"
                                          SelectedItem="{Binding SelectedGender, Mode=TwoWay}"
                                          IsEnabled="{Binding !IsRunning}"
                                          HorizontalAlignment="Stretch"  FontSize="13">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Text="{Binding DisplayName}" />
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>

						</Grid>

						<!-- Input Devices Radio List -->
            <StackPanel Grid.Row="2"
                         Grid.Column="0"
                         Grid.ColumnSpan="2"
                         Margin="0,20,15,0">

              <TextBlock Text="Microphone"
                         Foreground="White"
                         FontSize="13"
                         Margin="0,0,0,7"/>

              <Border Background="#252526"
                      Padding="10"
                      BorderBrush="#3E3E42"
                      BorderThickness="1"
                      CornerRadius="5">

                <Grid>
                  <!-- List -->
                  <ItemsControl ItemsSource="{Binding InputDevices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,1*"
                              Margin="0,0,0,8"
                              HorizontalAlignment="Stretch" MaxWidth="340">

                          <RadioButton Grid.Column="0"
                                       GroupName="InputDevices"
                                       IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                       Height="26"
                                       Width="26"/>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding FriendlyName}"
                                     Foreground="White"
                                     Margin="8,0,0,0"
                                     FontSize="11"
                                     TextWrapping="NoWrap"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Loader -->
                  <Border Background="#80000000"
                          IsVisible="{Binding IsInputDevicesLoading}"
                          CornerRadius="5"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
                    <Canvas Width="18" Height="18">
                      <!-- Rotating dots pattern for loading effect -->
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="0">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="2">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.125">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="15" Canvas.Top="8">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.25">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="14">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.375">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="16">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.5">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="14">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.625">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="-1" Canvas.Top="8">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.75">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                      <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="2">
                        <Ellipse.Styles>
                          <Style Selector="Ellipse">
                            <Style.Animations>
                              <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.875">
                                <KeyFrame Cue="0%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                                <KeyFrame Cue="12%">
                                  <Setter Property="Opacity" Value="0.3"/>
                                </KeyFrame>
                                <KeyFrame Cue="100%">
                                  <Setter Property="Opacity" Value="1.0"/>
                                </KeyFrame>
                              </Animation>
                            </Style.Animations>
                          </Style>
                        </Ellipse.Styles>
                      </Ellipse>
                    </Canvas>
                  </Border>
                </Grid>
              </Border>
            </StackPanel>



            <!-- Output Devices Radio List -->        
            <StackPanel Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,20,15,0">

              <TextBlock Text="Speaker"
                         Foreground="White"
                         FontSize="13"
                         Margin="0,0,0,7"/>

              <Border Background="#252526"
                      Padding="10"
                      BorderBrush="#3E3E42"
                      BorderThickness="1"
                      CornerRadius="5"
                      MaxWidth="400">

                <Grid>
                  <!-- List -->
                  <ItemsControl ItemsSource="{Binding OutputDevices}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid ColumnDefinitions="Auto,1*"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch" MaxWidth="340">

                            <RadioButton Grid.Column="0"
                                         GroupName="OutputDevices"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Height="26"
                                         Width="26"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding FriendlyName}"
                                       Foreground="White"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>


                  <!-- Loader -->
                  <Border Background="#80000000"
                          IsVisible="{Binding IsInputDevicesLoading}"
                          CornerRadius="5"
										HorizontalAlignment="Center"
										VerticalAlignment="Center">
                      <Canvas Width="18" Height="18">
                        <!-- Rotating dots pattern for loading effect -->
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="0">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="2">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.125">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="15" Canvas.Top="8">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.25">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="14">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.375">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="16">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.5">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="14">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.625">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="-1" Canvas.Top="8">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.75">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="2">
                          <Ellipse.Styles>
                            <Style Selector="Ellipse">
                              <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.875">
                                  <KeyFrame Cue="0%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="12%">
                                    <Setter Property="Opacity" Value="0.3"/>
                                  </KeyFrame>
                                  <KeyFrame Cue="100%">
                                    <Setter Property="Opacity" Value="1.0"/>
                                  </KeyFrame>
                                </Animation>
                              </Style.Animations>
                            </Style>
                          </Ellipse.Styles>
                        </Ellipse>
                      </Canvas>
                    </Border>                    
                </Grid>
              </Border>
            </StackPanel>


            <!--Meeting Connected Device-->
						<StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,20,15,0">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="Meeting Device" Foreground="White"  FontSize="13"  Margin="0,0,0,7"/>
							</StackPanel>

							<Border Background="#252526" Padding="10" BorderBrush="#3E3E42" BorderThickness="1,1,1,1"  CornerRadius="5">
								<StackPanel>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" >
										<TextBlock Text="(Make sure your meeting are connected to the right devices.)"
									   FontSize="11"
									   Foreground="#CCCCCC"
									   FontFamily="Segoe UI"
									   FontWeight="SemiBold"
									   FontStyle="Italic"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
										<TextBlock Text="Microphone:" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
										<TextBlock Text="" Width="8"/>
										<TextBlock Text="{Binding MeetingInputDeviceName}" FontSize="12" FontWeight="Normal" Foreground="#CCCCCC"/>
									</StackPanel>
									<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
										<TextBlock Text="Speaker:" FontSize="12" FontWeight="SemiBold" Foreground="#CCCCCC"/>
										<TextBlock Text="" Width="8"/>
										<TextBlock Text="{Binding MeetingOutputDeviceName}" FontSize="12" FontWeight="Normal" Foreground="#CCCCCC"/>
									</StackPanel>
								</StackPanel>
							</Border>
						</StackPanel>

						<!-- Spacer row to allow extra scroll space -->
						<Panel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Height="20"/>
					</Grid>
				</ScrollViewer>
			</Grid>
		</Border>

		<!-- Status Bar moved to root so it remains visible while settings overlays main content -->
		<Border Grid.Row="2" Grid.ColumnSpan="2"
                Background="#202124"
                Padding="10,8"
                BorderBrush="#3E3E42" BorderThickness="1,1,1,1">
			<Grid ColumnDefinitions="*,Auto,*">
				<!-- Session Info (Left) -->
				<!--<StackPanel Grid.Column="0"
							VerticalAlignment="Center"
							IsVisible="{Binding ShowSessionInfo}">
					<TextBlock Text="{Binding SessionInfo}"
							   Foreground="#90CAF9"
							   FontSize="11"
							   FontWeight="SemiBold"/>
					<TextBlock Text="{Binding SessionTimeRemaining}"
							   Foreground="{Binding IsSessionExpiring, Converter={StaticResource BoolToBrushConverter}, ConverterParameter=warning}"
							   FontSize="10"
							   Margin="0,2,0,0"/>
				</StackPanel>-->

				<!-- Start/Stop Button (Center) -->
				<Button Grid.Column="1"
                        Command="{Binding ToggleTranslationCommand}"
                        Width="80"
                        Height="26"
                        FontSize="13"
                        FontWeight="Bold"
                        Background="{Binding IsRunning, Converter={StaticResource BoolToBrushConverter}}"
                        Foreground="White"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,0,0"
                 IsEnabled="{Binding !IsInputDevicesLoading}"
                >
					<Button.Transitions>
						<Transitions>
							<DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
						</Transitions>
					</Button.Transitions>

					<!-- Button content with spinner -->
					<Grid>
						<!-- Main text -->
						<TextBlock Text="{Binding TranslationButtonText}"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"
								   IsVisible="{Binding !IsTransitioning}"/>

						<!-- Loading spinner -->
            <Border Width="18" Height="18"
                     IsVisible="{Binding IsTransitioning}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Canvas Width="18" Height="18">
                <!-- Rotating dots pattern for loading effect -->
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="0">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="2">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.125">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="15" Canvas.Top="8">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.25">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="13" Canvas.Top="14">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.375">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="7" Canvas.Top="16">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.5">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="14">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.625">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="-1" Canvas.Top="8">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.75">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="White" Canvas.Left="1" Canvas.Top="2">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.875">
                          <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                          <KeyFrame Cue="12%">
                            <Setter Property="Opacity" Value="0.3"/>
                          </KeyFrame>
                          <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1.0"/>
                          </KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
              </Canvas>
            </Border>


          </Grid>
				</Button>

				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
					<ToggleButton IsChecked="{Binding IsMicrophoneMuted, Mode=TwoWay}"
								  Classes="mute-button"
								  Width="30" Height="30"
								  CornerRadius="15"
								  Cursor="Hand">
						<Image Source="{Binding IsMicrophoneMuted, Converter={StaticResource BoolToImageConverter}}"
							   Width="16" Height="16"
							   Stretch="Uniform"/>
					</ToggleButton>
					<ToggleButton IsChecked="{Binding IsSpeakerMuted, Mode=TwoWay}"
								  Classes="mute-button"
								  Width="30" Height="30"
								  CornerRadius="15"
								  Cursor="Hand">
						<Image Source="{Binding IsSpeakerMuted, Converter={StaticResource BoolToImageConverter}, ConverterParameter=speaker}"
							   Width="16" Height="16"
							   Stretch="Uniform"/>
					</ToggleButton>
				</StackPanel>
			</Grid>
		</Border>
    </Grid>
    
    <!--Toast-->
    <!-- TOAST OVERLAY -->
    <Border
        IsVisible="{Binding Toast.IsVisible}"
        Background="#FFF2E2"
        CornerRadius="5"
        VerticalAlignment="Top"
        HorizontalAlignment="Center"
        Margin="0,40,0,0"
        Padding="6"
        ZIndex="9999"
        Width="360">

      <Grid ColumnDefinitions="Auto,*">

        <!-- Icon -->
        <TextBlock Text="⚠️"
                   FontSize="14"
                   Margin="0,2,12,0"
                   VerticalAlignment="Top"/>

        <!-- WRAPPING TEXT -->
        <TextBlock
            Text="{Binding Toast.Message}"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="#222"
            TextWrapping="Wrap"
            MaxWidth="340"/>

      </Grid>

    </Border>
    
	</Grid>
  
 
  
</Window>