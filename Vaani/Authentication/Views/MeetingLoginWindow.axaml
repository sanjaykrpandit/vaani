<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Vaani.Authentication.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="Vaani.Authentication.Views.MeetingLoginWindow"
        x:DataType="vm:MeetingLoginViewModel"
        Icon="/Assets/icon.ico"
        Title="Vaani"       
        Width="400" Height="650"
        MinWidth="400" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Design.DataContext>
        <vm:MeetingLoginViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <!-- Loading spinner animation -->
        <Style Selector="Border.loading-spinner">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid Background="#1E1E1E">
        <!-- Main Content -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400" Spacing="20">
            
            <!-- Logo and Title -->
			<!-- Logo and Title -->
			<StackPanel Spacing="10" HorizontalAlignment="Center">
				<Image Source="/Assets/icon.ico"
                       Width="64" Height="64"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
				<!--<TextBlock Text="Vaani"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>-->
				<TextBlock Text="Real-Time Meeting Translation"
                           FontSize="14"
                           Foreground="#CCCCCC"
                           HorizontalAlignment="Center"/>
			</StackPanel>

            <!-- Meeting ID Input Section -->
            <StackPanel Spacing="12" IsVisible="{Binding !IsValidating}">
                <TextBlock Text="Enter Meeting ID"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                
                <TextBox Text="{Binding MeetingId, Mode=TwoWay}"
                         Watermark="e.g., VM-2025-1220-A7B3"
                         FontSize="14"
                         Height="42"
                         Padding="15,12"
                         Background="#252526"
                         Foreground="White"
                         BorderBrush="#3E3E42"
                         BorderThickness="2"
                         CornerRadius="21"
						   Width="300"
						 Margin="40,10"
                         HorizontalContentAlignment="Center"
                         TextAlignment="Center"
                         FontFamily="Consolas,monospace">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding ValidateCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <!--<Button Content="Paste"
                            Command="{Binding PasteCommand}"
                            Width="100"
                            Height="32"
                            Background="#252526"
                            Foreground="White"
                            BorderBrush="#3E3E42"
                            BorderThickness="1"
                            CornerRadius="6" 
						    HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="13"/>-->
                    
                    <Button Content="Login"
                            Command="{Binding ValidateCommand}"
                            Width="300"
                            Height="32"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="16" 
							HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"/>
                </StackPanel>

                <!--<TextBlock Text="Example: VM-2025-1220-A7B3"
                           FontSize="12"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           FontStyle="Italic"/>-->
            </StackPanel>

            <!-- Validating State -->
			<!-- Validating State -->
			<StackPanel Spacing="15"
						HorizontalAlignment="Center"
						IsVisible="{Binding IsValidating}">
				<Border Width="60" Height="60"
						Background="#252526"
						CornerRadius="30"
						HorizontalAlignment="Center"
						Padding="15">
					<Canvas Width="30" Height="30">
						<!-- Rotating dots pattern for loading effect - same as MainWindow -->
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="12.5" Canvas.Top="0">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22" Canvas.Top="3.5">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.125">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="26" Canvas.Top="12.5">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.25">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="22" Canvas.Top="22">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.375">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="12.5" Canvas.Top="25">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.5">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="3" Canvas.Top="22">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.625">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="0" Canvas.Top="12.5">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.75">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
						<Ellipse Width="5" Height="5" Fill="White" Canvas.Left="3" Canvas.Top="3.5">
							<Ellipse.Styles>
								<Style Selector="Ellipse">
									<Style.Animations>
										<Animation Duration="0:0:1" IterationCount="Infinite" Delay="0:0:0.875">
											<KeyFrame Cue="0%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
											<KeyFrame Cue="12%">
												<Setter Property="Opacity" Value="0.3"/>
											</KeyFrame>
											<KeyFrame Cue="100%">
												<Setter Property="Opacity" Value="1.0"/>
											</KeyFrame>
										</Animation>
									</Style.Animations>
								</Style>
							</Ellipse.Styles>
						</Ellipse>
					</Canvas>
				</Border>

				<TextBlock Text="{Binding StatusMessage}"
						   FontSize="14"
						   Foreground="#90CAF9"
						   HorizontalAlignment="Center"
						   TextAlignment="Center"
						   TextWrapping="Wrap"
						   MaxWidth="350"/>
			</StackPanel>

            <!-- Error Message -->
            <Border Background="#D32F2F"
                    CornerRadius="8"
                    Padding="15,10"
					Margin="50"
                    IsVisible="{Binding HasError}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Error"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="13"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="350"/>
                    <Button Content="Try Again"
                            Command="{Binding RetryCommand}"
                            HorizontalAlignment="Center"
                            Margin="0,5,0,0"
                            Width="100"
                            Height="32"
                            Background="#252526"
                            Foreground="White"
                            BorderThickness="0"
							CornerRadius="6" 						
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"                          
                            FontSize="13"/>
                </StackPanel>
            </Border>

            <!-- Help Text -->
            <StackPanel Spacing="5" IsVisible="{Binding !IsValidating}">
                <TextBlock Text="Need help?"
                           FontSize="12"
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Contact your meeting organizer for the Meeting ID"
                           FontSize="11"
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="350"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
